# Postgres — Neon (hébergé) ou le conteneur du docker-compose.
DATABASE_URL=postgres://trajekt:trajekt@localhost:5432/trajekt

# Connexion au dashboard : un mot de passe, une session signée.
DASHBOARD_PASSWORD=change-me
DASHBOARD_SESSION_SECRET=replace-with-a-long-random-string

# Détection de régression (POST /api/alerts/check ou pnpm check-regressions).
CRON_SECRET=replace-with-another-random-string
# Optionnel : alertes Slack (Incoming Webhook) et lien vers le dashboard.
SLACK_WEBHOOK_URL=
TRAJEKT_PUBLIC_URL=http://localhost:3000

# Optionnel : table de prix pour l'estimation du coût (USD / million de tokens),
# fusionnée avec celle par défaut. Ex. : {"my-model":{"input":1,"output":3}}
TRAJEKT_PRICING=
